# -------------------------------------------------------------------------
# Strict Line Ending Rules for Linux Environments & AI Coding Agents
# -------------------------------------------------------------------------

# Force all text files to handle line endings automatically and use LF on disk
* text=auto eol=lf

# Ensure common code extensions are explicitly handled as Unix text files
*.nix text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.h text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.sh text eol=lf

# Keep Windows-specific scripts safe if they ever exist
*.bat text eol=crlf
*.cmd text eol=crlf
